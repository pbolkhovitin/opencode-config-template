{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-sonnet-4-5",
  "default_agent": "ui-designer",
  "agent": {
    "ui-designer": {
      "description": "UI/UX дизайнер — арт-дирекшн, дизайн-система, вёрстка, типографика, motion",
      "mode": "primary",
      "temperature": 0.3,
      "prompt": "{file:./prompts/personas/ui-designer.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "visual-qa": {
      "description": "Визуальная приёмка — скриншоты, адаптивность, контраст, focus-states, регрессии вёрстки",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:./prompts/personas/visual-qa.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    }
  },
  "instructions": [
    "instructions/context-protocol.md",
    "AGENTS.md",
    "instructions/bash.md",
    "instructions/core.md",
    "instructions/js-ts.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  "autoupdate": "notify",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "skill": {
      "*": "deny",
      "accessibility-a11y": "allow",
      "agent-vault": "allow",
      "brainstorming": "allow",
      "cavecrew": "allow",
      "caveman": "allow",
      "caveman-commit": "allow",
      "caveman-compress": "allow",
      "caveman-help": "allow",
      "caveman-review": "allow",
      "caveman-stats": "allow",
      "code-review-and-quality": "allow",
      "compress": "allow",
      "debugging-and-error-recovery": "allow",
      "design-toolkit": "allow",
      "dispatching-parallel-agents": "allow",
      "find-skills": "allow",
      "finishing-a-development-branch": "allow",
      "grill-me": "allow",
      "kpi-dashboard-design": "allow",
      "nextjs-react-typescript": "allow",
      "requesting-code-review": "allow",
      "systematic-debugging": "allow",
      "test-driven-development": "allow",
      "verification-before-completion": "allow",
      "web-scraping": "allow",
      "webapp-testing": "allow",
      "writing-plans": "allow"
    }
  },
  "snapshot": true,
  "watcher": {
    "ignore": [
      "node_modules",
      "dist",
      ".git",
      "*.log"
    ]
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--isolated"
        ],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--browser=firefox"
        ],
        "disabled": false
      },
      "penpot": {
        "type": "remote",
        "url": "http://localhost:9001/mcp/stream?userToken={env:PENPOT_MCP_TOKEN}",
        "disabled": false
      },
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": false
      },
      "mermaid": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-mermaid@latest"
        ],
        "environment": {
          "npm_config_ignore_scripts": "true"
        },
        "disabled": false
      },
      "duckduckgo": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "ddg-mcp-search"
        ],
        "disabled": false
      },
      "figma": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        },
        "disabled": true
      },
      "magic": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@21st-dev/magic@latest"
        ],
        "environment": {
          "API_KEY": "{env:MAGIC_API_KEY}"
        },
        "disabled": true
      },
      "unsplash": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "unsplash-mcp-server"
        ],
        "environment": {
          "UNSPLASH_ACCESS_KEY": "{env:UNSPLASH_ACCESS_KEY}"
        },
        "disabled": true
      }
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0",
    "opencode-supermemory",
    "opencode-gemini-auth",
    "opencode-handoff@0.6.1",
    "opencode-usage-monitor@3.1.0",
    "opencode-gpt-imagegen"
  ],
  "commands": {
    "profile": {
      "template": "echo \"Текущий профиль: $(basename $(dirname ${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}))\"",
      "description": "Показать текущий профиль opencode"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000
    },
    "buffer": 24000
  },
  "references": {
    "context": {
      "path": "~/.config/opencode/context",
      "description": "Context ledger. Read INDEX.md first, then only the needed file."
    },
    "docs": {
      "path": "~/.local/share/opencode/opencode-synced/repo/docs",
      "description": "Project docs; open only the relevant page."
    }
  }
}
