{
  "$schema": "https://opencode.ai/config.json",
  "theme": "matugen",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000
    },
    "buffer": 24000
  },
  "references": {
    "context": {
      "path": "~/.config/opencode/context",
      "description": "Context ledger. Read INDEX.md first, then only the needed file."
    },
    "docs": {
      "path": "~/.local/share/opencode/opencode-synced/repo/docs",
      "description": "Project docs; open only the relevant page."
    }
  },
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-sonnet-4-5",
  "agent": {
    "explore": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "general": {
      "model": "anthropic/claude-sonnet-4-5"
    }
  },
  "plugins": [
    "opencode-synced",
    "@tarquinen/opencode-dcp@3.2.0",
    "opencode-gemini-auth",
    "opencode-handoff@0.6.1",
    "opencode-usage-monitor@3.1.0",
    "opencode-supermemory"
  ],
  "instructions": [
    "instructions/russian.md",
    "instructions/workflow.md",
    "instructions/rules.md",
    "instructions/context-protocol.md"
  ],
  "mcp": {
    "servers": {}
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      ".cache/**",
      ".local/share/opencode/**"
    ]
  },
  "provider": {
    "gigachat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GigaChat",
      "options": {
        "baseURL": "https://api.giga.chat/v1"
      },
      "models": {
        "GigaChat-3-Ultra": {
          "name": "GigaChat 3 Ultra"
        },
        "GigaChat-3-Pro": {
          "name": "GigaChat 3 Pro"
        },
        "GigaChat-3-Lightning": {
          "name": "GigaChat 3 Lightning"
        },
        "GigaChat-2-Max": {
          "name": "GigaChat 2 Max"
        },
        "GigaChat-2-Pro": {
          "name": "GigaChat 2 Pro"
        },
        "GigaChat-2": {
          "name": "GigaChat 2"
        }
      }
    }
  }
}
