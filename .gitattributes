# Normalize line endings across platforms (Windows native, WSL, Linux)
* text=auto

# Shell scripts must keep LF (shebang safety)
*.sh text eol=lf
*.ps1 text eol=lf

# Config and docs as LF
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.py text eol=lf
